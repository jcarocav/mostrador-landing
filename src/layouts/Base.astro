---
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import jakarta from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import { marca, variablesCss } from '../marca/marca';
import { textos } from '../textos/textos';
import '../estilos/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** false en páginas de trabajo que no deben salir en buscadores. */
  indexar?: boolean;
  /** La imagen más grande de la primera pantalla: se pide antes que todo lo demás (es el LCP). */
  imagenPrincipal?: { srcset: string; sizes: string };
  colorTema?: string;
}

const {
  titulo = `${marca.nombre} · ${marca.lema}`,
  descripcion = marca.descripcion,
  indexar = true,
  imagenPrincipal,
  colorTema = marca.colores.marca[950],
} = Astro.props;

// Solo el subconjunto latino, que trae los acentos y la ñ. Autoalojadas: ninguna petición a terceros.
const fuentes = `
@font-face{font-family:'Plus Jakarta Sans Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${jakarta}) format('woff2-variations')}
@font-face{font-family:'Bricolage Grotesque Variable';font-style:normal;font-display:swap;font-weight:200 800;src:url(${bricolage}) format('woff2-variations')}`;
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {!indexar && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={colorTema} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      imagenPrincipal && (
        <link rel="preload" as="image" type="image/webp" imagesrcset={imagenPrincipal.srcset} imagesizes={imagenPrincipal.sizes} fetchpriority="high" />
      )
    }
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fuentes} />
    <style is:inline set:html={variablesCss} />
    <!--
      Con movimiento permitido y JavaScript, la página arranca en el estado inicial de las animaciones
      (.js-movimiento). Si el script no llega a empezar en 4 segundos, se quita la clase y todo queda a la
      vista: el contenido nunca se queda escondido.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('js-movimiento');
        window.__respaldoMovimiento = setTimeout(function () {
          d.classList.remove('js-movimiento');
        }, 4000);
      })();
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">{textos.saltarAlContenido}</a>
    <slot />
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 12px 16px;
    border-radius: 8px;
    background: var(--color-texto);
    color: var(--color-fondo);
    font-weight: 600;
    transform: translateY(-200%);
  }

  .saltar:focus-visible {
    transform: none;
  }
</style>
