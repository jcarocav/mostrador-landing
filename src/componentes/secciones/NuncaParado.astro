---
import ventaSinConexion from '../../assets/app/venta-sin-conexion-celular.png';
import { textos } from '../../textos/textos';
import Telefono from '../Telefono.astro';

const t = textos.nuncaParado;
---

<section id="sin-conexion" class="seccion seccion-campo" aria-labelledby="titulo-parado">
  <div class="marco parado">
    <div class="parado-texto">
      <div data-aparece>
        <h2 id="titulo-parado" class="seccion-titulo">{t.titulo}</h2>
        <p class="seccion-bajada">{t.bajada}</p>
      </div>
      <ol class="secuencia" data-secuencia>
        {
          t.secuencia.map((paso, i) => (
            <li class="secuencia-paso" data-paso-senal={i}>
              {paso}
            </li>
          ))
        }
      </ol>
      <dl class="detalles" data-aparece>
        {
          t.detalles.map((d) => (
            <div>
              <dt>{d.titulo}</dt>
              <dd>{d.texto}</dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="parado-telefono" data-aparece>
      <Telefono pantallas={[{ id: 'sin-conexion', src: ventaSinConexion, alt: t.alt }]} tamanos="(min-width: 1024px) 340px, 72vw" />
    </div>
  </div>
</section>

<style is:global>
  #sin-conexion .parado {
    display: grid;
    gap: 48px;
  }

  #sin-conexion .secuencia {
    display: grid;
    gap: 4px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  #sin-conexion .secuencia-paso {
    padding: 12px 16px;
    border-radius: 2px;
    background: var(--color-secundario);
    font-size: 1.125rem;
    font-weight: 700;
  }

  #sin-conexion .secuencia-paso:last-child {
    background: var(--color-exito-fondo);
  }

  /* Con movimiento, los tres estados se encienden en orden, una sola vez (ver escenas.ts). */
  .js-movimiento #sin-conexion .secuencia-paso {
    opacity: 0;
    transform: translateX(-12px);
    transition:
      opacity 240ms var(--curva-salida),
      transform 320ms var(--curva-salida);
  }

  .js-movimiento #sin-conexion .secuencia-paso.visible {
    opacity: 1;
    transform: none;
  }

  #sin-conexion .detalles {
    display: grid;
    gap: 20px;
    margin: 36px 0 0;
  }

  #sin-conexion dt {
    font-size: 1.125rem;
    font-weight: 700;
  }

  #sin-conexion dd {
    max-width: 46ch;
    margin: 2px 0 0;
    color: var(--color-texto-suave);
  }

  #sin-conexion .parado-telefono {
    --ancho-telefono: min(72vw, 340px);
    justify-self: center;
  }

  @media (min-width: 1024px) {
    #sin-conexion .parado {
      grid-template-columns: 1fr 340px;
      gap: 96px;
      align-items: center;
    }
  }
</style>
