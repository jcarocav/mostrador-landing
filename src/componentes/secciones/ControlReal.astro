---
import informeCierre from '../../assets/app/informe-cierre-celular.png';
import reportes from '../../assets/app/reportes-pc.png';
import stock from '../../assets/app/stock-pc.png';
import { textos } from '../../textos/textos';
import Captura from '../Captura.astro';
import Telefono from '../Telefono.astro';

const t = textos.control;
---

<section id="control" class="seccion marco" aria-labelledby="titulo-control">
  <div data-aparece>
    <h2 id="titulo-control" class="seccion-titulo">{t.titulo}</h2>
    <p class="seccion-bajada">{t.bajada}</p>
  </div>

  <div class="control-stock" data-aparece>
    <div class="control-texto">
      <h3>{t.stock.titulo}</h3>
      <p>{t.stock.texto}</p>
    </div>
    <Captura src={stock} alt={t.stock.alt} tamanos="(min-width: 1344px) 1248px, 92vw" />
  </div>

  <div class="control-par">
    <div class="control-caja" data-aparece>
      <div class="control-caja-telefono">
        <Telefono pantallas={[{ id: 'cierre', src: informeCierre, alt: t.caja.alt }]} tamanos="(min-width: 1024px) 260px, 56vw" />
      </div>
      <div class="control-texto">
        <h3>{t.caja.titulo}</h3>
        <p>{t.caja.texto}</p>
        <h3 class="control-personas">{t.personas.titulo}</h3>
        <p>{t.personas.texto}</p>
      </div>
    </div>
    <div class="control-reportes" data-aparece>
      <Captura src={reportes} alt={t.reportes.alt} tamanos="(min-width: 1024px) 50vw, 92vw" />
      <div class="control-texto">
        <h3>{t.reportes.titulo}</h3>
        <p>{t.reportes.texto}</p>
        <p class="control-pronto">
          <span>{t.reportes.pronto}</span>
          <span class="pronto">{textos.proximamente}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  h3 {
    margin: 0;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .control-texto p {
    max-width: 46ch;
    margin: 10px 0 0;
    font-size: 1.125rem;
  }

  .control-stock {
    display: grid;
    gap: 24px;
    margin-top: clamp(40px, 6vw, 72px);
  }

  .control-par {
    display: grid;
    gap: 64px;
    margin-top: clamp(56px, 8vw, 112px);
  }

  .control-caja {
    display: grid;
    gap: 32px;
  }

  .control-caja-telefono {
    --ancho-telefono: min(56vw, 260px);
  }

  .control-personas {
    margin-top: 36px;
  }

  .control-reportes {
    display: grid;
    gap: 24px;
    align-content: start;
  }

  .control-texto .control-pronto {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 16px;
    font-size: 1rem;
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .control-stock {
      grid-template-columns: 1fr;
    }

    .control-stock .control-texto {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: end;
    }

    .control-stock .control-texto p {
      margin: 0;
    }

    .control-par {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }

    .control-caja {
      grid-template-columns: 260px 1fr;
    }
  }
</style>
