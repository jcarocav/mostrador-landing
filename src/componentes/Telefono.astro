---
// Un celular con una o más capturas reales de la app apiladas. La activa se ve; las demás esperan
// (opacidad 0) para que un script las cambie. Sin JavaScript se ve la activa.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { ANCHOS_CELULAR, CALIDAD_CAPTURA, FORMATOS_CAPTURA } from '../config/imagenes';

interface Pantalla {
  id: string;
  src: ImageMetadata;
  alt: string;
}

interface Props {
  pantallas: Pantalla[];
  activa?: number;
  prioridad?: boolean;
  /** La pantalla que se ve primero, si no es la activa (la portada parte vacía y se llena). */
  primera?: number;
  class?: string;
  decorativo?: boolean;
  tamanos?: string;
}

const {
  pantallas,
  activa = 0,
  prioridad = false,
  primera = activa,
  class: clase,
  decorativo = false,
  tamanos = '(min-width: 1024px) 320px, 60vw',
} = Astro.props;
---

<figure class:list={['telefono', clase]} data-telefono aria-hidden={decorativo ? 'true' : undefined}>
  <div class="telefono-pantalla">
    {
      pantallas.map((p, i) => (
        <Picture
          src={p.src}
          alt={decorativo || i !== activa ? '' : p.alt}
          data-pantalla={p.id}
          data-alt={p.alt}
          class:list={['pantalla', { activa: i === activa }]}
          widths={ANCHOS_CELULAR}
          sizes={tamanos}
          formats={[...FORMATOS_CAPTURA]}
          fallbackFormat="webp"
          quality={CALIDAD_CAPTURA.avif}
          loading={prioridad && i === primera ? 'eager' : 'lazy'}
          fetchpriority={prioridad && i === primera ? 'high' : undefined}
          decoding={prioridad && i === primera ? 'sync' : 'async'}
        />
      ))
    }
  </div>
</figure>

<style is:global>
  .telefono {
    --bisel: var(--neutro-900);
    margin: 0;
    width: var(--ancho-telefono, 300px);
    padding: calc(var(--ancho-telefono, 300px) * 0.03);
    border-radius: calc(var(--ancho-telefono, 300px) * 0.15);
    background: var(--bisel);
  }

  .telefono .telefono-pantalla {
    position: relative;
    aspect-ratio: 390 / 844;
    overflow: hidden;
    border-radius: calc(var(--ancho-telefono, 300px) * 0.12);
    background: var(--neutro-50);
  }

  .telefono .pantalla {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  .telefono .pantalla.activa {
    opacity: 1;
  }
</style>
