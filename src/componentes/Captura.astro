---
// Captura real del portal en el PC, en varios tamaños. Las de celular van dentro de Telefono.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { ANCHOS_PC, CALIDAD_CAPTURA } from '../config/imagenes';

interface Props {
  src: ImageMetadata;
  alt: string;
  tamanos: string;
  class?: string;
}

const { src, alt, tamanos, class: clase } = Astro.props;
---

<Image class:list={['captura', clase]} {src} {alt} widths={ANCHOS_PC} sizes={tamanos} format="webp" quality={CALIDAD_CAPTURA} loading="lazy" decoding="async" />

<style>
  .captura {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
</style>
