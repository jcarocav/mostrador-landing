---
// Captura real del portal en el PC, en varios tamaños. Las de celular van dentro de Telefono.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { ANCHOS_PC, CALIDAD_CAPTURA, FORMATOS_CAPTURA } from '../config/imagenes';

interface Props {
  src: ImageMetadata;
  alt: string;
  tamanos: string;
  class?: string;
}

const { src, alt, tamanos, class: clase } = Astro.props;
---

<Picture
  class:list={['captura', clase]}
  {src}
  {alt}
  widths={ANCHOS_PC}
  sizes={tamanos}
  formats={[...FORMATOS_CAPTURA]}
  fallbackFormat="webp"
  quality={CALIDAD_CAPTURA.avif}
  loading="lazy"
  decoding="async"
/>

<style is:global>
  .captura {
    width: 100%;
    height: auto;
    border-radius: 2px;
  }
</style>
