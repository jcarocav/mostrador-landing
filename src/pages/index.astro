---
// Página provisoria de la Fase 0: solo comprueba la base (marca, textos, CI). La portada real se
// construye en la Fase 2, con la dirección visual que elija el dueño.
import Base from '../layouts/Base.astro';
import { marca } from '../marca/marca';
import { textos } from '../textos/textos';
---

<Base>
  <header class="barra">
    <a class="marca" href="/" aria-label={textos.logoAlt}>
      <span class="logo" set:html={marca.logoSvg} />
      <span>{marca.nombre}</span>
    </a>
  </header>
  <main id="contenido" class="contenido">
    <h1>{textos.portada.titulo}</h1>
    <p class="subtitulo">{textos.portada.subtitulo}</p>
    <p class="aviso">{textos.enConstruccion}</p>
  </main>
  <footer class="pie">
    <p>{textos.pie.derechos(new Date().getFullYear())}</p>
  </footer>
</Base>

<style>
  .barra,
  .contenido,
  .pie {
    width: 100%;
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding-inline: var(--margen);
  }

  .barra {
    padding-block: 20px;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: var(--color-texto);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
  }

  .logo {
    width: 32px;
    color: var(--color-accion);
  }

  .contenido {
    padding-block: clamp(48px, 12vh, 160px);
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .subtitulo {
    max-width: 52ch;
    margin: 32px 0 0;
    font-size: clamp(1.125rem, 2vw, 1.375rem);
  }

  .aviso {
    margin: 48px 0 0;
    color: var(--color-texto-suave);
  }

  .pie {
    padding-block: 32px;
    color: var(--color-texto-suave);
  }
</style>
