---
// Portada de la landing: dirección B, «Mostrador de noche» (DECISIONES.md #11).
import { getImage } from 'astro:assets';
import ventaVacia from '../assets/app/venta-vacia-celular.png';
import ArmaTuPlan from '../componentes/secciones/ArmaTuPlan.astro';
import Barra from '../componentes/secciones/Barra.astro';
import Confianza from '../componentes/secciones/Confianza.astro';
import Contacto from '../componentes/secciones/Contacto.astro';
import ControlReal from '../componentes/secciones/ControlReal.astro';
import CreceContigo from '../componentes/secciones/CreceContigo.astro';
import EmpiezaFacil from '../componentes/secciones/EmpiezaFacil.astro';
import NuncaParado from '../componentes/secciones/NuncaParado.astro';
import ParaTuRubro from '../componentes/secciones/ParaTuRubro.astro';
import Pie from '../componentes/secciones/Pie.astro';
import Planes from '../componentes/secciones/Planes.astro';
import Portada from '../componentes/secciones/Portada.astro';
import Preguntas from '../componentes/secciones/Preguntas.astro';
import { ANCHOS_CELULAR, CALIDAD_CAPTURA } from '../config/imagenes';
import Base from '../layouts/Base.astro';

// El celular de la portada es el LCP: su primera pantalla se precarga con el mismo srcset de la imagen.
const tamanosPortada = '(min-width: 1024px) 300px, 54vw';
const lcp = await getImage({ src: ventaVacia, widths: ANCHOS_CELULAR, format: 'avif', quality: CALIDAD_CAPTURA.avif });
---

<Base imagenPrincipal={{ srcset: lcp.srcSet.attribute, sizes: tamanosPortada }}>
  <Barra />
  <main id="contenido">
    <Portada tamanos={tamanosPortada} />
    <EmpiezaFacil />
    <ParaTuRubro />
    <NuncaParado />
    <ControlReal />
    <CreceContigo />
    <ArmaTuPlan />
    <Planes />
    <Confianza />
    <Preguntas />
    <Contacto />
  </main>
  <Pie />
</Base>

<script>
  import { cancelarRespaldo, hayMovimiento } from '../scripts/movimiento';

  // El movimiento llega después de la primera pintura: sus 130 KB no deben competir con el LCP. El respaldo
  // de 4 s de Base.astro sigue corriendo hasta que el script llegue: si llega tarde, la página ya quedó completa.
  const arrancar = () =>
    import('../scripts/escenas')
      .then((m) => {
        if (!hayMovimiento()) return;
        cancelarRespaldo();
        m.iniciar();
      })
      .catch(() => document.documentElement.classList.remove('js-movimiento'));

  if (hayMovimiento()) {
    const alCargar = () => ('requestIdleCallback' in window ? requestIdleCallback(arrancar, { timeout: 800 }) : setTimeout(arrancar, 200));
    if (document.readyState === 'complete') alCargar();
    else addEventListener('load', alCargar, { once: true });
  }
</script>
